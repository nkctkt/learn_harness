{
  "name": "learn-harness",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "verify": "scripts/verify.sh",
    "lint:types": "eslint .",
    "prepare": "lefthook install",
    "test": "pnpm -r test",
    "knip": "knip",
    "arch": "depcruise --config .dependency-cruiser.cjs apps/api/src apps/web/src"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
